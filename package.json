{
  "name": "rn-starter",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "prebuild": "expo prebuild",
    "build:preview": "npx --yes eas-cli@21.4.0 build --profile preview --platform all",
    "build:production": "npx --yes eas-cli@21.4.0 build --profile production --platform all",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "check:knip": "knip",
    "check:web-bundle": "npm run export:web && node scripts/check-web-bundle.mjs",
    "check": "npm run typecheck && npm run test:coverage -- --runInBand && npm run lint && npm run check:knip && npm run check:web-bundle",
    "doctor": "expo-doctor",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.18.6",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/query-persist-client-core": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "nativewind": "^4.2.6",
    "posthog-react-native": "^4.61.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.11.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/jest-preset": "0.86.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "1.20.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-test-renderer": "^19.2.8",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
