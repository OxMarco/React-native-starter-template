{
  "name": "rn-starter",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:preview": "npx --yes eas-cli build --profile preview --platform all",
    "build:production": "npx --yes eas-cli build --profile production --platform all",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "check:knip": "knip",
    "check": "npm run typecheck && npm test -- --runInBand && npm run lint && npm run check:knip",
    "doctor": "npx --yes expo-doctor"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@tanstack/query-async-storage-persister": "^5.100.10",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-persist-client": "^5.100.10",
    "expo": "~56.0.18",
    "expo-constants": "~56.0.20",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~56.0.5",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~56.0.4",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "knip": "^6.16.1",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-test-renderer": "^19.2.3",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
