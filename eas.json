{
  "cli": {
    "version": "21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "APP_NAME": "RN Starter",
        "APP_SLUG": "rn-starter",
        "APP_SCHEME": "rnstarter",
        "IOS_BUNDLE_IDENTIFIER": "com.example.rnstarter",
        "ANDROID_PACKAGE": "com.example.rnstarter"
      }
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
