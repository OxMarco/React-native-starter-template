# Copy this file to .env.local and replace every value for a new app, or run
# `npm run init` to be prompted for them.
#
# .env.local is gitignored, and EAS Build uploads the git-tracked project — so
# it NEVER reaches a cloud build. Mirror the same identity into eas.json
# (build.base.env) or publish it with `eas env:create`, or EAS falls back to the
# com.example placeholders. app.config.ts fails the build if that happens.
APP_NAME="My App"
APP_SLUG="my-app"
APP_SCHEME="myapp"
IOS_BUNDLE_IDENTIFIER="com.example.myapp"
ANDROID_PACKAGE="com.example.myapp"

# Run `npx eas-cli init` for the new project, then place its id here.
# EAS_PROJECT_ID="00000000-0000-0000-0000-000000000000"

# Values prefixed with EXPO_PUBLIC_ are inlined into the JavaScript bundle and
# are readable by anyone with the binary. Never put a secret in one.
# EXPO_PUBLIC_API_ORIGIN="https://api.example.com"
