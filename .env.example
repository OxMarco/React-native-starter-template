# Copy this file to .env.local and replace every value for a new app, or run
# `npm run init` to be prompted for them.
#
# .env.local is gitignored, and EAS Build uploads the git-tracked project — so
# it NEVER reaches a cloud build. Mirror the same identity into eas.json
# (build.base.env) or publish it with `eas env:create`, or EAS falls back to the
# starter placeholders. app.config.ts fails the build if that happens.
APP_NAME="My App"
APP_SLUG="my-app"
APP_SCHEME="myapp"
IOS_BUNDLE_IDENTIFIER="com.example.myapp"
ANDROID_PACKAGE="com.example.myapp"

# Run `npx --yes eas-cli@21.4.0 init` for the new project, then place its id here.
# EAS_PROJECT_ID="00000000-0000-0000-0000-000000000000"

# Values prefixed with EXPO_PUBLIC_ are inlined into the JavaScript bundle and
# are readable by anyone with the binary. Never put a secret in one.
# EXPO_PUBLIC_API_ORIGIN="https://api.example.com"

# --- Crash reporting (Sentry) -------------------------------------------------
# All optional. With no DSN the SDK initialises disabled and the app runs
# normally. The DSN is a write-only public key and is embedded in the bundle by
# design; SENTRY_AUTH_TOKEN is a real secret and belongs in an EAS secret only.
# SENTRY_DSN="https://public@o0.ingest.sentry.io/0"
# SENTRY_ORG="my-org"
# SENTRY_PROJECT="my-app"
# Attaches the reporting device's IP and request headers to events. Leaving this
# off is part of what keeps the default opt-out consent model defensible: the
# data stays anonymous, so no prior consent is required to collect it.
# SENTRY_SEND_DEFAULT_PII="false"

# --- Product analytics (PostHog) ----------------------------------------------
# Optional; without a key the analytics facade stays a no-op. The project API
# key is write-only and public. Defaults to the EU cloud.
# POSTHOG_API_KEY="phc_..."
# POSTHOG_HOST="https://eu.i.posthog.com"

# --- Store listing ------------------------------------------------------------
# Drives the on-device "update available" prompt. Android reuses ANDROID_PACKAGE
# above; iOS needs the numeric App Store id, which only exists once the app has
# been created in App Store Connect. APP_STORE_COUNTRY is the storefront queried
# (a release can reach one region before another) and defaults to "us".
# APP_STORE_ID="1234567890"
# APP_STORE_COUNTRY="us"
